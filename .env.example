# =============================================================================
# Supabase — linked dev project: SecurePass (ref sigyrlchpkmxzuyilmpf), region ap-northeast-2.
# Populate URL / keys via Dashboard → Project Settings → API, or Supabase MCP:
#   get_project_url, get_publishable_keys (anon JWT + optional sb_publishable_*).
# Service role is never returned by MCP; copy only from Dashboard into server-only env.
# =============================================================================
SUPABASE_PROJECT_REF=sigyrlchpkmxzuyilmpf
NEXT_PUBLIC_SUPABASE_URL=https://sigyrlchpkmxzuyilmpf.supabase.co
# Legacy anon JWT (used by @supabase/ssr + this repo’s browser client).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_JWT
# Modern publishable key (optional; sb_publishable_* — see Supabase API settings).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres host for CLI/migrations (password from Dashboard → Database).
# DATABASE_URL=postgresql://postgres.[PASSWORD]@db.sigyrlchpkmxzuyilmpf.supabase.co:5432/postgres

# Server-only — never expose to browser / never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI personal access token (local machine only): https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Browser-visible site URL (OAuth redirects, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Crypto posture flag for deployment docs / checks (browser reads only if prefixed NEXT_PUBLIC)
ENCRYPTION_MODE=client_e2ee
MISTRAL_API_KEY=
# Flagship chat model (alias tracks latest Large). Use mistral-small-latest for cheaper dev.
MISTRAL_CHAT_MODEL=mistral-large-latest
# Rate limit per authenticated user (fixed window, in-memory on single node)
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# DEV ONLY — Next.js AI/security routes (disabled unless true). Production uses Edge Functions.
AI_PROXY_USE_NEXT_ROUTE=false
# DEV ONLY — browser falls back to Next routes when Edge invoke fails (never enable in prod).
NEXT_PUBLIC_AI_USE_NEXT_FALLBACK=false

# Edge secret for cleanup-expired-messages (header x-cleanup-secret). Set in Supabase Dashboard → Edge secrets.
# CLEANUP_EXPIRED_SECRET=
